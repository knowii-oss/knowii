{
  "name": "knowii-oss/knowii",
  "type": "project",
  "description": "Knowii",
  "keywords": [
    "knowii"
  ],
  "license": "GNU AFFERO GENERAL PUBLIC LICENSE Version 3",
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "bepsvpt/secure-headers": "^9.1",
    "cviebrock/eloquent-sluggable": "^13.0",
    "dedoc/scramble": "^0.13",
    "fivefilters/readability.php": "^4.0",
    "guzzlehttp/guzzle": "^7.10 || ^8.0",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/framework": "^13.0",
    "laravel/jetstream": "^5.5",
    "laravel/reverb": "^1.12",
    "laravel/sanctum": "^4.3",
    "laravel/tinker": "^3.0",
    "league/commonmark": "^2.7",
    "league/html-to-markdown": "^5.1",
    "mews/purifier": "^3.4",
    "resend/resend-php": "^1.18",
    "spatie/laravel-backup": "^10.0",
    "taylornetwork/laravel-username-generator": "^2.8",
    "tightenco/ziggy": "^2.0",
    "visus/cuid2": "^7.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.8",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.14",
    "laravel/pint": "^1.32",
    "laravel/sail": "^1.69",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "db:clean": [
      "sail php artisan migrate:fresh --seed --force"
    ],
    "sail:cache:clean": [
      "sail artisan cache:clear && sail artisan route:clear && sail artisan config:clear && sail artisan view:clear"
    ],
    "sail:clean": [
      "sail down --volumes && sail build --no-cache && sail up -d && composer db:clean"
    ],
    "serve": [
      "composer start"
    ],
    "start": [
      "sail up -d && sail npm run dev"
    ],
    "stop": [
      "sail down"
    ],
    "test": [
      "sail php artisan test"
    ],
    "lint": [
      "./vendor/bin/phpstan analyze --memory-limit=1G"
    ],
    "format": [
      "./vendor/bin/pint"
    ],
    "generate-phpdoc": [
      "sail php artisan ide-helper:models --write --no-interaction",
      "composer format"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "barryvdh/laravel-ide-helper"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

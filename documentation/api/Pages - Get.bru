meta {
  name: Pages - Get
  type: http
  seq: 85
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of a page space>/pages/<cuid of a page>
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  One page with its Markdown (body) and its HTML (body_html). Ability pages:read.
  Public: in a public space this request works without a session and without a token (the response carries the name, username and avatar of the authors, never more). Every other space answers 401 without an account.
}

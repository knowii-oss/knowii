meta {
  name: Access groups - List space groups
  type: http
  seq: 143
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/access-groups/<group cuid>/space-groups
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  The space groups that an access group opens whole, in navigation order (#1422, ADR 0041). Owner, admins, moderators with the manage members or manage spaces right. Token ability: groups:read.
}

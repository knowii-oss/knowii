meta {
  name: Space Groups - Set access groups
  type: http
  seq: 146
}

put {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/space-groups/q8kspacegroupstarthere01/access-groups
  body: json
  auth: none
}

headers {
  Accept: application/json

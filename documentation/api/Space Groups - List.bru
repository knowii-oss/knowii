meta {
  name: Space Groups - List
  type: http
  seq: 21
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/space-groups
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  The space groups of the community, in order, with the spaces that the user can see. Members do not get empty groups; admins do.
  Public (#1485): a visitor and a signed-in person who is not a member get the public spaces only, never a chat space, when the community has a public space that is not a chat space. Otherwise 404 for a visitor and 403 for a signed-in person.
}

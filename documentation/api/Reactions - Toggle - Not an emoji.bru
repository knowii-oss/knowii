meta {
  name: Reactions - Toggle - Not an emoji
  type: http
  seq: 48
}

post {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of a discussion space>/posts/<post cuid>/reactions
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "emoji": "angry"
  }
}

docs {
  Returns 400: the emoji must come from the allow-list of the picker (resources/emoji/allowed.json), never free text.
}

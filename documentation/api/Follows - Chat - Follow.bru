  type: http
  seq: 170
}

put {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of a chat space>/messages/<cuid of a first-level message>/follow
  body: none
  auth: none
}

headers {

meta {
  name: Events - Update
  type: http
  seq: 190
}

patch {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of an events space>/events/<cuid of an event>
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "title": "Weekly review office hour (new room)",
    "meeting_url": "https://meet.example.com/new-room"
  }
}

docs {
  Changes an event (#1513): the owner, the admins and the host. Each field is optional; the times are checked with the stored values of the absent fields. The slug stays. sequence goes up when the start, the end, the meeting address or the place changes. A change tells nobody. Ability events:write.
}

meta {
  name: Event Comments - Who reacted
  type: http
  seq: 234
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of an events space>/events/<cuid of an event>/comments/<comment cuid>/reactions
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Who reacted to a comment of an event, per emoji. 404 for an event that you may not see; a signed-in person who is not a member reads it in a public space, as the comments. Ability events:read.
}

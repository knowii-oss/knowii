meta {
  name: Event Comments - Reply
  type: http
  seq: 230
}

post {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of an events space>/events/<cuid of an event>/comments
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "body": "I agree.",
    "parent_cuid": "<comment cuid>"
  }
}

docs {
  Replies to a comment of an event. A reply to a reply goes to its top-level comment (one level only). The reply tells the author of the comment. Ability events:write.
}

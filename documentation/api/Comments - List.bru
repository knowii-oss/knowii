meta {
  name: Comments - List
  type: http
  seq: 40
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of a discussion space>/posts/<post cuid>/comments
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  The comments of a post, oldest first, each with its replies (oldest first). metadata.totalCount counts comments and replies.
}

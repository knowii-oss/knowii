meta {
  name: Posts - Get
  type: http
  seq: 35
}

get {
  url: {{BASE_URL}}/api/v1/communities/nswswk8w8wso0ko8owwk8k0w/spaces/<cuid of a discussion space>/posts/<post cuid>
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Returns a post with its Markdown source (body) and its HTML (body_html).
  Public: in a public space this request works without a session and without a token (the response carries the name, username and avatar of the authors, never more). Every other space answers 401 without an account.
}

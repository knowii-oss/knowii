{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/knowii/src/**/*.ts",
    "apps/knowii/src/**/*.tsx",
    "libs/common/src/**/*.ts",
    "libs/common/src/**/*.tsx",
    "apps/*/vite.config.mts",
    "libs/*/vite.config.mts",
    "vitest.config.mts"
  ],
  "exclude": ["**/*.spec.ts", "**/*.spec.tsx", "**/*.test.ts", "**/*.test.tsx", "**/node_modules"]
}

APP_NAME=Knowii
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_PORT=4200

# Required when using Docker Compose directly instead of the Sail wrapper
WWWUSER=1000
WWWGROUP=1000

# Optional image overrides for corporate registries
# SAIL_BASE_IMAGE=ubuntu:24.04
# POSTGRES_IMAGE=postgres:18
# REDIS_IMAGE=redis:alpine

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Should be set to true in production
SESSION_SECURE_COOKIE=false

# Should be set to __Secure-knowii_session in production
# Reference: https://scotthelme.co.uk/tough-cookies/
SESSION_COOKIE=knowii_session

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
#LOG_STACK=single
# Production: LOG_STACK=daily keeps one file per day, deleted after LOG_DAILY_DAYS (the privacy policy says 14)
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@developassion.be"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (emails: https://resend.com/)
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# Sail Debug
# Reference: https://laravel.com/docs/11.x/sail#debugging-with-xdebug
# Enable XDebug
XDEBUG_MODE=debug
# Configure XDebug
SAIL_XDEBUG_MODE=develop,debug,coverage
# Point to XDebug within the Sail containers
XDEBUG_CONFIG="client_host=host.docker.internal"

# WebSockets - Reverb
BROADCAST_CONNECTION=reverb

# Reverb configuration
REVERB_APP_ID=13371337133742
REVERB_APP_KEY=knowii-ws-app-foobar
REVERB_APP_SECRET=rnz3h0wwjny7d2pejxvh
REVERB_ALLOWED_ORIGINS=localhost
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
## Max request size (in KB)
REVERB_MAX_REQUEST_SIZE=2500000
## Max message size (in KB)
REVERB_APP_MAX_MESSAGE_SIZE=2500000

# Reverb server
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=4201

# Reverb (where Laravel and clients send events)
REVERB_HOST="localhost"
REVERB_PORT=4201
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Content Security Policy: extra origins (comma-separated, never a whole scheme such as https:). See SELF_HOSTING.md.
# Disk of the images that members upload (config/filesystems.php): public (default, run php artisan storage:link) or an S3-compatible disk
UPLOADS_DISK=public
# Public URL of the uploaded files when another host serves them (S3-compatible bucket or CDN)
UPLOADS_PUBLIC_URL=
CSP_IMG_SRC=
CSP_MEDIA_SRC=
CSP_FRAME_SRC=
CSP_CONNECT_SRC=
# Vite dev server origin (local environment only). Default: http://localhost:${VITE_PORT}
VITE_DEV_SERVER_URL=

# Waitlist on the welcome page (EmailOctopus API v2). Leave empty to disable the waitlist.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_WAITLIST_LIST_ID=
# pending (double opt-in, recommended) or subscribed
EMAILOCTOPUS_WAITLIST_CONTACT_STATUS=pending
# Newsletter form in the footer (#938): leave empty to hide the form. It also needs the Turnstile keys.
EMAILOCTOPUS_NEWSLETTER_LIST_ID=
EMAILOCTOPUS_NEWSLETTER_CONTACT_STATUS=pending

# Reserved community names (#1340, ADR 0036): names that only the accounts below give to a shared community, added to
# the built-in list of config/communities.php. Example: COMMUNITY_RESERVED_NAMES="Acme,Acme Academy"
COMMUNITY_RESERVED_NAMES=
# Email addresses (verified accounts) that can use a reserved name, separated by commas
COMMUNITY_RESERVED_NAMES_OWNERS=

# Crawling (#104): true lets search engines index the public pages (default: true in production only).
# false on acceptance and private instances: robots.txt refuses every crawler, every page sends noindex.
ROBOTS_ALLOW_INDEXING=false

# Cloudflare Turnstile (bot check of the waitlist form). Required: without keys the waitlist refuses signups.
# The values below are the Cloudflare test keys (always pass). Replace them with the real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Retention periods (ADR 0030, config/retention.php): the scheduled prune tasks apply them, the privacy policy shows them
RETENTION_EXPIRED_INVITATIONS_DAYS=30
RETENTION_EXPIRED_API_TOKENS_DAYS=30
RETENTION_FAILED_JOBS_DAYS=7
RETENTION_UNUSED_UPLOADS_DAYS=7
RETENTION_WAITLIST_MONTHS=12
RETENTION_INACTIVE_CONTACTS_DAYS=30
# The backup script on the server must keep the same snapshots (#1182)
RETENTION_BACKUPS_DAILY=7
RETENTION_BACKUPS_WEEKLY=4
RETENTION_BACKUPS_MONTHLY=12

# Plausible statistics through a proxy (#1316): leave empty outside production. Example for knowii.net:
# PLAUSIBLE_DOMAIN=knowii.net
# PLAUSIBLE_PROXY_URL=https://blue-bar-dsebastien-19fd.developassion.workers.dev
PLAUSIBLE_DOMAIN=
PLAUSIBLE_PROXY_URL=

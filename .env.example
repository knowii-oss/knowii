APP_NAME=Knowii
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
APP_PORT=4200

# Required when using Docker Compose directly instead of the Sail wrapper
WWWUSER=1000
WWWGROUP=1000

# Optional image overrides for corporate registries
# SAIL_BASE_IMAGE=ubuntu:24.04
# POSTGRES_IMAGE=postgres:18
# REDIS_IMAGE=redis:alpine

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Should be set to true in production
SESSION_SECURE_COOKIE=false

# Should be set to __Secure-knowii_session in production
# Reference: https://scotthelme.co.uk/tough-cookies/
SESSION_COOKIE=knowii_session

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
#LOG_STACK=single
# Production: LOG_STACK=daily keeps one file per day, deleted after LOG_DAILY_DAYS (the privacy policy says 14)
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (emails: https://resend.com/)
RESEND_KEY=

# Email delivery (#1477, ADR 0054, SELF_HOSTING.md step 4 and "Mail volume")
# The queue of the notification mail, read by its own worker. default: the first worker reads it (one worker only)
MAIL_QUEUE=mail
# Notification mail sent per second, for all mail workers together (Resend allows 10 requests a second). 0: no limit
MAIL_RATE_LIMIT_PER_SECOND=5
# The mail that the plan of your mail provider allows each month. Empty: the limit that Resend gives, else none.
# If other products send with the same account of your mail provider, set this value lower than the limit of your plan.
MAIL_MONTHLY_QUOTA=
# Notification mail stops at this share of the monthly quota, so that the sign-in links keep a reserve (1 to 100)
MAIL_NOTIFICATION_HOLD_PERCENT=95
# The addresses that get the alert of the mail budget at 80%, separated by commas. Empty: the warning in the log is the alert
MAIL_ALERT_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173

# Storybook (npm run storybook, in the container): the port on the host
STORYBOOK_PORT=6006

# Sail Debug
# Reference: https://laravel.com/docs/11.x/sail#debugging-with-xdebug
# Enable XDebug
XDEBUG_MODE=debug
# Configure XDebug
SAIL_XDEBUG_MODE=develop,debug,coverage
# Point to XDebug within the Sail containers
XDEBUG_CONFIG="client_host=host.docker.internal"

# WebSockets - Reverb
BROADCAST_CONNECTION=reverb

# Reverb configuration
REVERB_APP_ID=13371337133742
REVERB_APP_KEY=knowii-ws-app-foobar
REVERB_APP_SECRET=rnz3h0wwjny7d2pejxvh
REVERB_ALLOWED_ORIGINS=localhost
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
## Max request size (in KB)
REVERB_MAX_REQUEST_SIZE=2500000
## Max message size (in KB)
REVERB_APP_MAX_MESSAGE_SIZE=2500000

# Reverb server
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=4201

# Reverb (where Laravel and clients send events)
REVERB_HOST="localhost"
REVERB_PORT=4201
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Content Security Policy: extra origins (comma-separated, never a whole scheme such as https:). See SELF_HOSTING.md.
# Disk of the images that members upload (config/filesystems.php): public (default, run php artisan storage:link) or an S3-compatible disk
UPLOADS_DISK=public
# Public URL of the uploaded files when another host serves them (S3-compatible bucket or CDN)
UPLOADS_PUBLIC_URL=
CSP_IMG_SRC=
CSP_MEDIA_SRC=
CSP_FRAME_SRC=
CSP_CONNECT_SRC=
# Vite dev server origin (local environment only). Default: http://localhost:${VITE_PORT}
VITE_DEV_SERVER_URL=

# Mailing lists (EmailOctopus API v2). Leave empty to disable them.
EMAILOCTOPUS_API_KEY=
# The list of the old waitlist, which takes no new address (#1574): only the prune of its contacts reads it. Leave empty
# on a new instance.
EMAILOCTOPUS_WAITLIST_LIST_ID=
# Newsletter form in the footer (#938): leave empty to hide the form. It also needs the Turnstile keys.
EMAILOCTOPUS_NEWSLETTER_LIST_ID=
# pending (double opt-in, recommended) or subscribed
EMAILOCTOPUS_NEWSLETTER_CONTACT_STATUS=pending

# Course materials (#1336, ADR 0037): the private disk of the files (local, or an S3-compatible disk of
# config/filesystems.php; never public) and the maximum size of a file in megabytes
COURSE_MATERIALS_DISK=local
COURSE_MATERIALS_MAX_MB=50

# Reserved community names (#1340, ADR 0036): names that only the accounts below give to a shared community, added to
# the built-in list of config/communities.php. Example: COMMUNITY_RESERVED_NAMES="Acme,Acme Academy"
COMMUNITY_RESERVED_NAMES=
# Email addresses (verified accounts) that can use a reserved name, separated by commas
COMMUNITY_RESERVED_NAMES_OWNERS=

# Crawling (#104): true lets search engines index the public pages (default: true in production only).
# false on acceptance and private instances: robots.txt refuses every crawler, every page sends noindex.
ROBOTS_ALLOW_INDEXING=false

# security.txt (#1559, RFC 9116) at /.well-known/security.txt: where a person reports a security problem. mailto:,
# https:// or tel: addresses, separated by commas, in the order of preference. Empty: no security.txt.
SECURITY_TXT_CONTACTS=
# Optional: the date after which the file is stale (ISO 8601). Empty: 180 days after the current day.
SECURITY_TXT_EXPIRES=
# Optional (https): the security policy (empty: the security page of the application), the public key for encrypted
# reports, the page that thanks the reporters. The languages of a report that you read.
SECURITY_TXT_POLICY=
SECURITY_TXT_ENCRYPTION=
SECURITY_TXT_ACKNOWLEDGMENTS=
SECURITY_TXT_PREFERRED_LANGUAGES=en

# Cloudflare Turnstile (bot check of the sign-up and newsletter forms). Required: without keys the newsletter refuses signups.
# The values below are the Cloudflare test keys (always pass). Replace them with the real keys in production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sign in with an OpenID Connect provider (#1385, ADR 0045). Off unless the issuer, the client ID and the client secret are
# all set. Register <APP_URL>/auth/oidc/callback at the provider. The issuer must be https (a loopback address over http is
# allowed in the local environment only). The scope offline_access is never asked.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
# The text of the button, "Continue with <label>". Without it: the host name of the issuer
OIDC_LABEL=
# An account without a password confirms the deletion of the account with a new sign-in at the provider (#1521, ADR 0052): the
# sign-in must be at most this many seconds old, and the deletion follows within this many seconds (60 to 900). The provider must
# support max_age and send auth_time
OIDC_FRESH_SIGN_IN_SECONDS=300
# The entitlements of the provider feed the access groups (#1386, ADR 0047). Off unless the address is set. The address of the
# read of one person: https, with {subject} once in the path, for example https://provider.example/v1/subjects/{subject}/entitlements
OIDC_ENTITLEMENTS_URL=
# The scope of the client credentials grant (the provider gives it to the confidential clients that it registered for it)
OIDC_ENTITLEMENTS_SCOPE=entitlements:read:subjects
# The audience or resource parameter of the token request, when the provider needs one
OIDC_ENTITLEMENTS_RESOURCE=
# With the feature on, the sign-in also asks this scope: the provider links the client to the person only then
OIDC_ENTITLEMENTS_SIGN_IN_SCOPE=entitlements:read
# The communities (slugs, separated by commas) whose owner and admins may give an access group by an entitlement key. Empty: none
OIDC_ENTITLEMENT_COMMUNITIES=

# The values of this instance (#1653, ADR 0055, SELF_HOSTING.md section "Instance values").
# Required in production, where the application refuses to start without them: who runs this instance (the invitation
# email names it, GDPR art. 14) and its public contact address (the contact page, the footer, the account deletion texts).
# Outside production, a value that is not set gets a neutral placeholder ("Example Operator", contact@example.com).
# LEGAL_OPERATOR="Example Ltd (Ireland)"
# LEGAL_CONTACT_EMAIL=contact@example.com
# Optional, empty hides it. The publisher: the footer shows "© <year> <name>." and the structured data names it (with its
# https address)
INSTANCE_PUBLISHER_NAME=
INSTANCE_PUBLISHER_URL=
# A short text after the "©" text of the footer, for example "Made in Ireland."
INSTANCE_FOOTER_NOTE=
# More links of the "Community" column of the footer: "Label=https://address" entries, separated by commas.
# Example: INSTANCE_FOOTER_LINKS="Blog=https://blog.example.com,Forum=https://forum.example.com"
INSTANCE_FOOTER_LINKS=
# The icon links of the footer: "key=https://address" entries, separated by commas. The keys are those of the social
# links of a profile (website, newsletter, linkedin, youtube, github, ...).
# Example: INSTANCE_SOCIAL_LINKS="github=https://github.com/example,linkedin=https://social.example.com/example"
INSTANCE_SOCIAL_LINKS=
# The address of the first user that the database seeder creates (development only)
SEED_ADMIN_EMAIL=admin@example.com

# Retention periods (ADR 0030, config/retention.php): the scheduled prune tasks apply them, the privacy policy shows them
RETENTION_EXPIRED_INVITATIONS_DAYS=30
RETENTION_EXPIRED_API_TOKENS_DAYS=30
RETENTION_FAILED_JOBS_DAYS=7
RETENTION_UNUSED_UPLOADS_DAYS=7
RETENTION_NOTIFICATIONS_READ_DAYS=60
RETENTION_NOTIFICATIONS_UNREAD_DAYS=90
RETENTION_WAITLIST_MONTHS=12
RETENTION_INACTIVE_CONTACTS_DAYS=30
# An export file (php artisan communities:export or users:export) is deleted after this many days (#1353)
RETENTION_EXPORTS_DAYS=7
# The backup script on the server must keep the same snapshots (#1182)
RETENTION_BACKUPS_DAILY=7
RETENTION_BACKUPS_WEEKLY=4
RETENTION_BACKUPS_MONTHLY=12

# Plausible statistics through a proxy (#1316): leave empty outside production. Example:
# PLAUSIBLE_DOMAIN=community.example.com
# PLAUSIBLE_PROXY_URL=https://stats.example.com
PLAUSIBLE_DOMAIN=
PLAUSIBLE_PROXY_URL=

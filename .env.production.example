# Environment of the production Docker stack (compose.production.yaml, SELF_HOSTING.md section "Docker").
# Copy this file to .env next to compose.production.yaml, replace every CHANGE_ME, and never commit the result.
# Generate APP_KEY with: docker run --rm --entrypoint php ghcr.io/knowii-oss/knowii:main artisan key:generate --show

# --- Compose ----------------------------------------------------------------------------------------------------------
# Mandatory. One name per environment on a server (acceptance and production must never share one).
COMPOSE_PROJECT_NAME=knowii-acceptance
# The image to run (built by GitHub Actions). A tag such as sha-1a2b3c4 pins a version.
KNOWII_IMAGE=ghcr.io/knowii-oss/knowii:main
# Host ports, on 127.0.0.1 only: the proxy in front forwards to them
KNOWII_APP_PORT=3400
KNOWII_REVERB_PORT=3401

# --- Application ------------------------------------------------------------------------------------------------------
APP_NAME=Knowii
APP_ENV=production
APP_KEY=CHANGE_ME
APP_DEBUG=false
APP_URL=https://app.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Behind a proxy: the addresses of the proxy that Laravel trusts for X-Forwarded-For and X-Forwarded-Proto.
# With Docker, the proxy reaches the container from the address of the Docker network gateway, which changes from one
# network to another: * is the practical value, because the ports are published on 127.0.0.1 only (only the proxy of
# this server can reach them). Use a list of addresses when the proxy is on another machine.
TRUSTED_PROXIES=*

# Who runs this instance: the invitation email names it (GDPR art. 14)
LEGAL_OPERATOR="Example Operator"

# true lets search engines index the public pages. Keep false on an acceptance or a private instance.
ROBOTS_ALLOW_INDEXING=false

# security.txt (#1559, RFC 9116) at /.well-known/security.txt: where a person reports a security problem. mailto:,
# https:// or tel: addresses, separated by commas, in the order of preference. Empty: no security.txt.
SECURITY_TXT_CONTACTS=
# Optional: the date after which the file is stale (ISO 8601). Empty: 180 days after the current day.
SECURITY_TXT_EXPIRES=
# Optional (https): the security policy (empty: the security page of the application), the public key for encrypted
# reports, the page that thanks the reporters. The languages of a report that you read.
SECURITY_TXT_POLICY=
SECURITY_TXT_ENCRYPTION=
SECURITY_TXT_ACKNOWLEDGMENTS=
SECURITY_TXT_PREFERRED_LANGUAGES=en

# --- Sessions and cookies ---------------------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=app.example.com
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Secure-knowii_session
BCRYPT_ROUNDS=12

# --- Logs (stderr: read them with docker compose logs) ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (the postgres service) ----------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=knowii
DB_USERNAME=knowii
DB_PASSWORD=CHANGE_ME
# POSTGRES_IMAGE=postgres:18

# --- Queue, cache, files ----------------------------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=
FILESYSTEM_DISK=local
UPLOADS_DISK=public
UPLOADS_PUBLIC_URL=
COURSE_MATERIALS_DISK=local
COURSE_MATERIALS_MAX_MB=50

# --- Email (Resend by default) ----------------------------------------------------------------------------------------
MAIL_MAILER=resend
MAIL_FROM_ADDRESS="contact@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=CHANGE_ME

# Email delivery (#1477, ADR 0054, SELF_HOSTING.md step 4 and "Mail volume")
# The queue of the notification mail, read by its own worker. default: the first worker reads it (one worker only)
MAIL_QUEUE=mail
# Notification mail sent per second, for all mail workers together (Resend allows 10 requests a second). 0: no limit
MAIL_RATE_LIMIT_PER_SECOND=5
# The mail that the plan of your mail provider allows each month. Empty: the limit that Resend gives, else none.
# If other products send with the same account of your mail provider, set this value lower than the limit of your plan.
MAIL_MONTHLY_QUOTA=
# Notification mail stops at this share of the monthly quota, so that the sign-in links keep a reserve (1 to 100)
MAIL_NOTIFICATION_HOLD_PERCENT=95
# The addresses that get the alert of the mail budget at 80%, separated by commas. Empty: the warning in the log is the alert
MAIL_ALERT_TO=

# --- WebSockets (Reverb) ----------------------------------------------------------------------------------------------
# One host name for the app and Reverb: the proxy forwards /app/ and /apps/ to the reverb service (SELF_HOSTING.md).
# The browser and Laravel use the public name; the server binds inside its container.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=app.example.com
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_MAX_REQUEST_SIZE=2500000
REVERB_APP_MAX_MESSAGE_SIZE=2500000

# The browser build takes REVERB_APP_KEY, REVERB_HOST, REVERB_PORT, REVERB_SCHEME and APP_NAME from this file when the
# container starts (docker/production/entrypoint.sh): the same image runs in every environment.

# --- Content Security Policy: extra origins (comma-separated, never a whole scheme) -----------------------------------
CSP_IMG_SRC=
CSP_MEDIA_SRC=
CSP_FRAME_SRC=
CSP_CONNECT_SRC=

# --- Outside services -------------------------------------------------------------------------------------------------
# Newsletter (EmailOctopus), and the list of the old waitlist for the prune of its contacts only. Leave empty to disable.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_WAITLIST_LIST_ID=
EMAILOCTOPUS_NEWSLETTER_LIST_ID=
EMAILOCTOPUS_NEWSLETTER_CONTACT_STATUS=pending
# Cloudflare Turnstile. Required: without keys the newsletter refuses signups. Use the test keys of Cloudflare outside production.
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
# Statistics through a proxy: leave empty when unused
PLAUSIBLE_DOMAIN=
PLAUSIBLE_PROXY_URL=
# Sign in with an OpenID Connect provider (#1385, ADR 0045). Leave the first three empty to turn it off. Register
# <APP_URL>/auth/oidc/callback at the provider. The issuer must be https. The scope offline_access is never asked.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email"
# The text of the button: "Continue with <label>". Without it, the host name of the issuer
OIDC_LABEL=
# An account without a password deletes itself after a new sign-in at the provider (#1521, ADR 0052): the sign-in is at most this
# many seconds old, and the deletion follows within this many seconds (60 to 900). The provider must support max_age and send auth_time
OIDC_FRESH_SIGN_IN_SECONDS=300
# The entitlements of the provider feed the access groups (#1386, ADR 0047). Leave the address empty to turn it off. The address
# of the read of one person: https, with {subject} once in the path. The provider calls <APP_URL>/webhooks/oidc/entitlements
OIDC_ENTITLEMENTS_URL=
OIDC_ENTITLEMENTS_SCOPE=entitlements:read:subjects
OIDC_ENTITLEMENTS_RESOURCE=
OIDC_ENTITLEMENTS_SIGN_IN_SCOPE=entitlements:read
# The communities (slugs, separated by commas) that may use entitlement rules. Empty: none
OIDC_ENTITLEMENT_COMMUNITIES=

# --- Reserved community names -----------------------------------------------------------------------------------------
COMMUNITY_RESERVED_NAMES=
COMMUNITY_RESERVED_NAMES_OWNERS=

# --- Retention periods (ADR 0030): the scheduled prune tasks apply them, the privacy policy shows them ----------------
RETENTION_EXPIRED_INVITATIONS_DAYS=30
RETENTION_EXPIRED_API_TOKENS_DAYS=30
RETENTION_FAILED_JOBS_DAYS=7
RETENTION_UNUSED_UPLOADS_DAYS=7
RETENTION_NOTIFICATIONS_READ_DAYS=60
RETENTION_NOTIFICATIONS_UNREAD_DAYS=90
RETENTION_WAITLIST_MONTHS=12
RETENTION_INACTIVE_CONTACTS_DAYS=30
RETENTION_EXPORTS_DAYS=7
RETENTION_BACKUPS_DAILY=7
RETENTION_BACKUPS_WEEKLY=4
RETENTION_BACKUPS_MONTHLY=12

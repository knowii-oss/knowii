    "prettier": "3.9.10",
    "release-it": "21.1.2",
    "replace-in-file": "9.0.0",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "basic-ftp": "6.2.6",
    "postcss-selector-parser@<6.1.5": "6.1.6",
